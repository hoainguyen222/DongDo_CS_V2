# =============================================================================
# DongDo CS — Production ENV template
# =============================================================================
# Copy this file to .env at the project root and fill in the real values.
#
#   cp .env.production.example .env
#
# After editing, run:
#   make nginx-dhparam     # one-off per host, takes minutes
#   make up                # brings up the stack (HTTP on :80 + HTTPS on :443)
#   make nginx-ssl-init    # issues the first Let's Encrypt cert via HTTP-01
#   make docker-nginx-reload
#
# Renewal is automatic via the certbot sidecar container (sleep 12h between
# checks, then `certbot renew --webroot`).
# =============================================================================

# ----- Core server -----
PORT=8080
SERVER_HOST=0.0.0.0

# ----- Database (PostgreSQL) -----
# Use the in-network hostname (postgres) inside the docker stack.
DATABASE_URL=postgres://postgres:CHANGEME@postgres:5432/dongdo_cs?sslmode=disable

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- Qdrant -----
QDRANT_HOST=qdrant
QDRANT_PORT=6334

# ----- AI providers -----
ANTHROPIC_API_KEY=sk-ant-CHANGEME
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ----- Paths -----
DOCUMENTS_DIR=./tailieu

# ----- WebRTC -----
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ----- JWT (CHANGE — min 32 chars) -----
JWT_SECRET=please-replace-this-with-a-real-32-char-random-secret-CHANGEME
JWT_EXPIRY_HOURS=168

# ----- Cookies -----
# COOKIE_DOMAIN must match the public domain (without scheme) when serving over HTTPS.
COOKIE_DOMAIN=cskh.dongdopartners.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# ----- App env -----
APP_ENV=production

# ----- Admin path -----
ADMIN_PATH=/admin
NEXT_PUBLIC_ADMIN_PATH=/admin

# ----- Bootstrap (set true ONCE to create the first owner; then false) -----
ENABLE_BOOTSTRAP=false

# =============================================================================
# Observability
# =============================================================================
METRICS_ENABLED=true
METRICS_ADDR=0.0.0.0:9090
PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060
BUSINESS_METRICS_ENABLED=true
BUSINESS_METRICS_POLL_SEC=15
REDIS_POOL_METRICS_ENABLED=true

# =============================================================================
# NGINX / TLS — for cskh.dongdopartners.com
# =============================================================================
# Public hostname nginx serves. Must match the certbot -d flag below.
NGINX_SERVER_NAME=cskh.dongdopartners.com

# "true" enables the :443 server block (HTTPS). Keep true in production.
NGINX_ENABLE_SSL=true

# Cert paths inside the nginx container. Defaults match the certbot sidecar.
SSL_CERT_PATH=/etc/letsencrypt/live/cskh.dongdopartners.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/cskh.dongdopartners.com/privkey.pem

# Max upload size for ASR audio files.
UPLOAD_LIMIT=50M

# Email for Let's Encrypt expiry notices.
CERTBOT_EMAIL=ops@dongdopartners.com

# How often the certbot sidecar checks for renewal (hours).
CERTBOT_RENEW_HOURS=12

# Set to "1" to use Let's Encrypt staging server (for testing renewal flows).
# Leave unset for production.
# CERTBOT_STAGING=

# =============================================================================
# GRAFANA — change these before exposing Grafana anywhere
# =============================================================================
GRAFANA_PORT=3050
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-strong-password
GRAFANA_ROOT_URL=https://cskh.dongdopartners.com

# Comma-separated list of Grafana plugins to auto-install at boot.
GRAFANA_PLUGINS=redis-datasource
# Toggle individual datasources ("true" = provisioned, "false" = hidden).
GRAFANA_PG_DATASOURCE=true
GRAFANA_REDIS_DATASOURCE=true

# =============================================================================
# Postgres (postgres container) — credentials referenced by postgres-exporter
# and by the Grafana Postgres datasource. Must match POSTGRES_PASSWORD in
# docker-compose.yml.
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME-strong-db-password
POSTGRES_DB=dongdo_cs

# =============================================================================
# Asterisk / call service
# =============================================================================
ASTERISK_USER=asterisk
ASTERISK_PASS=CHANGEME-call-service-password
