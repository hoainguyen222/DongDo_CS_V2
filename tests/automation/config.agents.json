  "test_scenarios": {
    "smoke_test": {
      "description": "1 agent, 2 guests, 2 messages - smoke test nhanh",
      "guest_count": 2,
      "messages_per_guest": 2,
      "ai_questions": [
        "Hàng hóa phái sinh là gì?",
        "Cách nạp tiền vào tài khoản?"
      ]
    },
    "light_load": {
      "description": "3 agents, 5 guests/guest, 5 messages - nhẹ, test AI response",
      "guest_count": 5,
      "messages_per_guest": 5,
      "ai_questions": [
        "Hàng hóa phái sinh là gì?",
        "Cách nạp tiền vào tài khoản?",
        "Giới thiệu về DDP Invest",
        "Quản lý rủi ro khi giao dịch",
        "Phí giao dịch là bao nhiêu?"
      ]
    },
    "medium_load": {
      "description": "5 agents, 10 guests/guest, 8 messages - trung bình, test AI + CS team",
      "guest_count": 10,
      "messages_per_guest": 8,
      "concurrent_agents": 5,
      "ai_questions": [
        "Hàng hóa phái sinh là gì?",
        "Cách nạp tiền vào tài khoản?",
        "Giới thiệu về DDP Invest",
        "Quản lý rủi ro khi giao dịch",
        "Phí giao dịch là bao nhiêu?",
        "Làm sao để rút tiền?",
        "Thời gian giao dịch là khi nào?",
        "Có ứng dụng mobile không?"
      ]
    },
    "heavy_load": {
      "description": "5 agents, 20 guests/guest, 10 messages - nặng, test chịu tải",
      "guest_count": 20,
      "messages_per_guest": 10,
      "concurrent_agents": 5,
      "ai_questions": [
        "Hàng hóa phái sinh là gì?",
        "Cách nạp tiền?",
        "Giới thiệu DDP Invest",
        "Quản lý rủi ro",
        "Phí giao dịch?",
        "Làm sao rút tiền?",
        "Thời gian giao dịch?",
        "Có app mobile không?"
      ]
    },
    "stress_test": {
      "description": "5 agents, 50 guests/guest, 5 messages - stress test cực nặng",
      "guest_count": 50,
      "messages_per_guest": 5,
      "concurrent_agents": 5,
      "burst_messages": true
    },
    "ai_load_test": {
      "description": "Test AI response under load - 10 guests đồng thời, AI xử lý hết",
      "guest_count": 10,
      "messages_per_guest": 5,
      "ai_questions": [
        "Hàng hóa phái sinh là gì?",
        "Cách nạp tiền vào tài khoản?",
        "Giới thiệu về DDP Invest",
        "Quản lý rủi ro khi giao dịch",
        "Phí giao dịch là bao nhiêu?",
        "Làm sao để rút tiền?",
        "Thời gian giao dịch là khi nào?",
        "Có ứng dụng mobile không?",
        "Tôi muốn mở tài khoản giao dịch",
        "Hỗ trợ tôi về hợp đồng futures"
      ]
    },
    "cs_team_load_test": {
      "description": "Test CS team response - 5 agents nhận case từ 20 guests",
      "guest_count": 20,
      "messages_per_guest": 3,
      "human_escalation": true,
      "ai_questions": [
        "Tôi cần hỗ trợ từ chuyên viên",
        "Không hiểu về cách đặt lệnh",
        "Cần người thật hỗ trợ ngay",
        "Tài khoản của tôi có vấn đề",
        "Giúp tôi với giao dịch"
      ]
    }
  },

  "ai_test_questions": [
    {
      "id": "q001",
      "category": "product",
      "question": "Hàng hóa phái sinh là gì?",
      "expected_keywords": ["phái sinh", "commodity", "hợp đồng"]
    },
    {
      "id": "q002",
      "category": "account",
      "question": "Cách nạp tiền vào tài khoản?",
      "expected_keywords": ["nạp", "tiền", "tài khoản"]
    },
    {
      "id": "q003",
      "category": "product",
      "question": "Giới thiệu về DDP Invest",
      "expected_keywords": ["DDP", "đầu tư", "nền tảng"]
    },
    {
      "id": "q004",
      "category": "trading",
      "question": "Quản lý rủi ro khi giao dịch",
      "expected_keywords": ["rủi ro", "quản lý", "dừng lỗ"]
    },
    {
      "id": "q005",
      "category": "trading",
      "question": "Phí giao dịch là bao nhiêu?",
      "expected_keywords": ["phí", "giao dịch", "hoa hồng"]
    },
    {
      "id": "q006",
      "category": "account",
      "question": "Làm sao để rút tiền?",
      "expected_keywords": ["rút", "tiền", "tài khoản"]
    },
    {
      "id": "q007",
      "category": "trading",
      "question": "Thời gian giao dịch là khi nào?",
      "expected_keywords": ["giờ", "giao dịch", "thị trường"]
    },
    {
      "id": "q008",
      "category": "product",
      "question": "Có ứng dụng mobile không?",
      "expected_keywords": ["app", "mobile", "điện thoại"]
    }
  ],

  "human_cs_triggers": [
    {
      "id": "trigger_001",
      "pattern": "tôi cần hỗ trợ",
      "expected_action": "escalate_to_human"
    },
    {
      "id": "trigger_002",
      "pattern": "không hiểu",
      "expected_action": "escalate_to_human"
    },
    {
      "id": "trigger_003",
      "pattern": "giúp tôi",
      "expected_action": "escalate_to_human"
    },
    {
      "id": "trigger_004",
      "pattern": "cần người thật",
      "expected_action": "escalate_to_human"
    },
    {
      "id": "trigger_005",
      "pattern": "chuyên viên",
      "expected_action": "escalate_to_human"
    }
  ],

  "reporting": {
    "save_reports": true,
    "report_directory": "./reports",
    "report_format": "json",
    "include_screenshots": false,
    "console_output": true,
    "verbose": false
  }
}
