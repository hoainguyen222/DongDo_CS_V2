# =============================================================================
# DongDo CSKH — Docker environment template
# Copy to .env next to docker-compose.yml and adjust before `make up`.
# =============================================================================

# ============================================================
#  AI provider credentials (existing; required for startup)
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.1

# ============================================================
#  Backend webapp env (existing)
# ============================================================
JWT_SECRET=change_me_in_production_min_32_chars_xxxxxxxx
JWT_EXPIRY_HOURS=168
APP_ENV=development
ADMIN_PATH=/admin
NEXT_PUBLIC_ADMIN_PATH=/admin
ENABLE_BOOTSTRAP=false
DOCUMENTS_DIR=./tailieu
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Public base URLs the Next.js frontend will hit
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ============================================================
#  Asterisk PBX (NEW)
# ============================================================
# Master switch — backend reads this to enable/disable AMI integration
ASTERISK_ENABLED=true

# Display names used by backend for logging
ASTERISK_USER=dongdo
ASTERISK_PASS=dongdoami              # AMI admin  (used by backend AMI client)
ASTERISK_MONITOR_PASS=dongdomonitor # AMI read-only (dashboards)
ASTERISK_ARI_USER=dongdo
ASTERISK_ARI_PASS=dongdoari          # ARI REST/WS (used by backend ARI client)
ASTERISK_ARI_READ_PASS=dongdoread    # ARI read-only

# SIP endpoint secrets (templated into pjsip.conf at container boot)
ASTERISK_GUEST_PASS=dongdoguest        # Browser SIP clients register with this
ASTERISK_AGENT_PASS_PREFIX=dongdoagent # Agent password = prefix + extension
ASTERISK_TRUNK_USER=mocktrunk          # Outbound trunk ITSP username
ASTERISK_TRUNK_PASS=mocktrunkpass      # Outbound trunk ITSP password

# Voicemail PIN (shared default across all mailboxes)
ASTERISK_VM_PASS=1234

# Agent extensions (CS soft-phones register with these)
AGENT_EXT_1=1001
AGENT_EXT_2=1002
AGENT_EXT_3=1003
AGENT_EXT_4=1004
AGENT_EXT_5=1005

# Optional: enable ODBC CDR pipeline (point at postgres)
ASTERISK_CDR_ODBC_DSN=                 # e.g. PostgreSQL-DSN, leave empty to disable

# ============================================================
# ⚠️  PRODUCTION CHECKLIST
# ============================================================
# 1. Replace EVERY "change_me" / "dongdo*" password above.
# 2. Set ASTERISK_PASS 32+ chars random.
# 3. Disable ASTERISK_TRUNK_USER mock values when wiring real ITSP.
# 4. Restrict AMI permit= in `docker/asterisk/etc/asterisk/manager.conf`.
# 5. Enable TLS by adding certs to docker/asterisk/etc/asterisk/keys/.
# 6. Tune RTP port range (compose: 10000-20000) to your network bandwidth.
# 7. Rotate JWT_SECRET regularly; same length and complexity as SSH keys.