# Docker Compose local overrides (per-developer)
docker-compose.override.yml
docker-compose.local.yml

# Certbot working files (--work-dir, --logs-dir)
/docker/nginx/certbot/logs/
/docker/nginx/certbot/lib/

# Nginx logs (when bind-mounted for debugging)
/docker/nginx/logs/
