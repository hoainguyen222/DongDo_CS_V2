# =============================================================================
# WEB (Next.js) - consumed by web service in docker-compose.yml
# =============================================================================
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=DongDo CS
NEXT_PUBLIC_ADMIN_PATH=/admin

# Inside the compose network, the Go backend service is reachable as `server`.
# `BACKEND_URL` is read at build time by `next.config.js` to set up rewrites,
# so rebuilding the web image is required if you change it here.
BACKEND_URL=http://server:8080

# These are public-facing origins — set them to your real domain (or leave
# blank for "same-origin only" deployments behind nginx).
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_URL=

# Optional overrides
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302
NEXT_PUBLIC_LOG_LEVEL=warn
