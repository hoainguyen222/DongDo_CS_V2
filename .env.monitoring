# =============================================================================
# OBSERVABILITY / MONITORING STACK — standalone env file
# =============================================================================
# This file is read ONLY by the monitoring services (Prometheus, Grafana,
# Alertmanager, exporters) via docker-compose.monitoring.yml env_file.
# The Go server's own observability settings (METRICS_ADDR, PPROF_ADDR,
# BUSINESS_METRICS_*) live in the main .env — they control how the server
# binds its own /metrics and /debug/pprof endpoints.
#
# Usage:
#   docker compose -f docker-compose.yml -f monitoring/docker-compose.monitoring.yml \
#     --profile monitoring up -d
#
# Or via Makefile:
#   make monitoring-up   (Makefile passes -f docker-compose.yml -f monitoring/docker-compose.monitoring.yml)
#
# IMPORTANT: Change these before any non-local exposure.

# ---- Grafana -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Root URL must match the host port so OAuth redirects and deep links work.
# If you change GRAFANA_PORT below, update this too.
GRAFANA_ROOT_URL=http://localhost:3050
# Host port for Grafana UI (3050, not 3000, avoids colliding with Next.js).
GRAFANA_PORT=3050

# ---- Prometheus -------------------------------------------------------
# Prometheus listens on host port PROMETHEUS_PORT (default 9091), bound to
# 127.0.0.1 only. We deliberately do NOT use 9090 because the Go server
# publishes /metrics on host:9090 in docker-compose.yml — keeping them
# on separate ports prevents "Bind for 0.0.0.0:9090 failed: port is already
# allocated" when both stacks run together.
#
# Override example:  PROMETHEUS_PORT=9091  (or any free port)
PROMETHEUS_PORT=9091
