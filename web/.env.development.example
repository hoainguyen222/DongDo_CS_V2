# =============================================================================
# Web (Next.js) — Development environment
# -----------------------------------------------------------------------------
# Loaded automatically by Next.js when you run `npm run dev` on the host
# (i.e. NOT inside Docker). Copy this file to `.env.development` and adjust.
#
# Public variables (exposed to the browser) MUST be prefixed with NEXT_PUBLIC_.
# =============================================================================

# Backend API base (proxied through Next.js rewrites when accessed via same origin)
# Local dev: NextJS proxies to http://localhost:8080 on host machine
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# When the NextJS container runs in Docker alongside the Go server,
# BACKEND_URL becomes http://server:8080 (compose service name).

# Application
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=DongDo CS

# Admin path (must match server's ADMIN_PATH)
NEXT_PUBLIC_ADMIN_PATH=/admin

# Public WebSocket URL (browser connects directly to backend WS)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Public STUN (optional override)
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302

# Logging
NEXT_PUBLIC_LOG_LEVEL=debug
