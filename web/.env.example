# ============================================================
# Web (Next.js) runtime / build-time environment
# ============================================================
# These are read by web/next.config.js at build time and by the standalone
# server at runtime. Anything that must be visible to the browser needs
# the NEXT_PUBLIC_ prefix.
#
# When running under `docker compose up`, the values below are baked into
# the image by docker-compose.yml. Override locally by exporting these in
# your shell before `npm run dev` or `npm run build`.

# Backend API base. The Next.js server proxies /api, /auth, /guest,
# /history, /chat, /static, /ws to this URL.
#   - Docker compose: http://server:8080
#   - Local dev:      http://localhost:8080
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Admin panel URL prefix used by the client-side middleware. Must match
# the server-side ADMIN_PATH in the backend .env.
NEXT_PUBLIC_ADMIN_PATH=/admin
