# =============================================================================
# Web (Next.js) — Production environment
# -----------------------------------------------------------------------------
# Loaded automatically by Next.js when you run `next start` / `npm start`
# OUTSIDE Docker. In a Docker setup these values come from:
#   - The root `.env` file at the project root, which Docker Compose reads.
#   - `web` service's `build.args` in `docker-compose.yml` (for NEXT_PUBLIC_*).
#   - `web` service's `environment:` in `docker-compose.yml` (for BACKEND_URL).
#
# CRITICAL: `NEXT_PUBLIC_*` variables are INLINED into the JS bundle at
# BUILD TIME. Passing them only via `environment:` in compose is too late —
# `next start` won't re-inline them. They MUST be passed as `build.args`
# in docker-compose.yml (already wired up in this repo).
# =============================================================================

# Backend URL when NextJS runs in Docker (compose network)
BACKEND_URL=http://server:8080

# Public-facing origin (set to your real domain).
# This is read by the BROWSER, so make sure it matches the externally
# reachable URL of the Next.js server (after any external nginx/proxy).
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=DongDo CS

# Admin path
NEXT_PUBLIC_ADMIN_PATH=/admin

# WebSocket URL used by the browser. Use `wss://` in production
# (TLS is terminated at the external nginx / reverse proxy).
NEXT_PUBLIC_WS_URL=wss://yourdomain.com

# STUN servers for WebRTC voice calling (comma-separated)
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302

NEXT_PUBLIC_LOG_LEVEL=warn
