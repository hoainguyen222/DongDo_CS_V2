# =============================================================================
# Web (Next.js) — Production environment
# -----------------------------------------------------------------------------
# IMPORTANT: `NEXT_PUBLIC_*` variables are INLINED into the JS bundle at
# BUILD TIME. The web/Dockerfile copies `web/.env` directly in the builder
# stage and sources it, so these values are baked into the image.
#
# For LOCAL development: use `web/.env` with local IPs.
# For PRODUCTION on AWS: rename this to `web/.env` (or use `web/.env.production`)
#   and set the public-facing domain below.
#
# Runtime vars (BACKEND_URL, etc.) are passed via docker-compose `env_file:`
# and reach `next start` directly — those don't need to be baked in.
# =============================================================================

# Backend URL — use the Docker Compose service name when running inside compose,
# so the web container talks to the server via the internal network.
BACKEND_URL=http://server:8080

# Public-facing URLs — set to your real domain used by browsers.
# nginx/reverse proxy terminates TLS and forwards to port 3000.
NEXT_PUBLIC_API_URL=https://cskh.dongdopartners.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=DongDo CS

# Admin path
NEXT_PUBLIC_ADMIN_PATH=/admin

# WebSocket URL — use wss:// (TLS) in production.
# nginx/reverse proxy forwards ws://localhost:3000 to the backend.
NEXT_PUBLIC_WS_URL=wss://cskh.dongdopartners.com

# STUN servers for WebRTC voice calling
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302

# Log level: debug (verbose), warn (production recommended)
NEXT_PUBLIC_LOG_LEVEL=warn
