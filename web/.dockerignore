# =============================================================================
# .dockerignore for the `web/` image build context
# -----------------------------------------------------------------------------
# Keep the build context small and exclude any local secrets / caches.
# =============================================================================

# VCS
.git
.gitignore

# Build artefacts (produced inside the image, never ship them in)
.next
out
build
dist

# Dependencies (must be installed inside the image)
node_modules

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log
.pnpm-debug.log

# OS / IDE noise
.DS_Store
.vscode
.idea

# TypeScript build info
*.tsbuildinfo

# Next.js generated types
next-env.d.ts

# Local env files — never bake secrets into an image
.env
.env*.local
.env.development
.env.production

# Tests & coverage
coverage

# Storybook (unused here, defensive)
.storybook

# Example / dev-only files (not needed at runtime)
*.md
README.md

# Docker / compose meta-files (defensive: prevents recursive copy in monorepo)
Dockerfile*
docker-compose*.yml

# ESLint cache
.eslintcache

# Generated UI assets
public/uploads
