# =============================================================================
# .dockerignore for the `web/` image build context
# -----------------------------------------------------------------------------
# Keep the build context small and exclude any local secrets / caches.
# =============================================================================

# VCS
.git
.gitignore

# Build artefacts (produced inside the image, never ship them in)
.next
out
build
dist

# Dependencies (must be installed inside the image)
node_modules

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log
.pnpm-debug.log

# OS / IDE noise
.DS_Store
.vscode
.idea

# TypeScript build info
*.tsbuildinfo

# Next.js generated types
next-env.d.ts

# Local env files for development / secrets — NOT excluded here because the
# Dockerfile builder stage needs them to inline NEXT_PUBLIC_* into the JS bundle.
# Only .env.production is used for builds, and it should contain non-secret
# public values only. Sensitive values (DB passwords, API keys) belong in
# docker-compose `env_file:` / `environment:` or secret stores, never baked in.
.env*.local
.env.development

# Tests & coverage
coverage

# Storybook (unused here, defensive)
.storybook

# Example / dev-only files (not needed at runtime)
*.md
README.md

# Docker / compose meta-files (defensive: prevents recursive copy in monorepo)
docker-compose*.yml

# ESLint cache
.eslintcache

# Generated UI assets
public/uploads
