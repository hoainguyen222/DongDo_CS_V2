# Server Configuration
PORT=8080
SERVER_HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/dongdo_cs?sslmode=disable

# Redis (Upstash or Local)
# Upstash example: rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Anthropic Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RETRIEVER_K=5
MEMORY_WINDOW_SIZE=10

# Paths
DOCUMENTS_DIR=./tailieu

# STUN Servers for WebRTC Voice Calling
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
