# Server Configuration
PORT=8080
SERVER_HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/dongdo_cs?sslmode=disable

# Redis (Upstash or Local)
# Upstash example: rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Anthropic Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RETRIEVER_K=5
MEMORY_WINDOW_SIZE=10

# Paths
DOCUMENTS_DIR=./tailieu

# STUN Servers for WebRTC Voice Calling
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# JWT Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRY_HOURS=168

# Cookie Settings
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Application Environment
APP_ENV=development

# Admin Path Configuration (default: /admin)
# Server-side path (used by middleware)
ADMIN_PATH=/admin
# Client-side path (exposed to browser via NEXT_PUBLIC_)
NEXT_PUBLIC_ADMIN_PATH=/admin

# Bootstrap / First-time Setup
# Set to true to enable /admin/setup page for creating the first owner account
ENABLE_BOOTSTRAP=false

# ============================================================
# Asterisk AMI (Asterisk Manager Interface) Integration
# ============================================================
# Enable real PSTN/SIP dialing through an Asterisk PBX. When disabled the
# voice flow runs in DB-only mode (WebRTC only). When enabled the backend
# connects to Asterisk over TCP, dials both legs of a call (guest + agent)
# and tracks call state in real time through AMI events.
ASTERISK_ENABLED=false
ASTERISK_HOST=localhost
ASTERISK_PORT=5038
ASTERISK_USER=dongdo
ASTERISK_PASS=changeme
ASTERISK_CONTEXT=from-internal
ASTERISK_TRUNK=PJSIP/trunk
ASTERISK_QUEUE=dongdo-queue

# ============================================================
# Asterisk ARI (Asterisk REST Interface) Integration
# ============================================================
# ARI powers the WebRTC/Stasis flow: the Go backend connects to Asterisk's
# WebSocket to receive live call events (channel created, bridge, dtmf, etc.)
# and can issue REST calls to create bridges, answer channels, and control
# the call lifecycle.  Frontend browsers connect to Asterisk directly via
# sip.js (SIP over WebSocket) so audio is handled by Asterisk natively.
ASTERISK_ARI_ENABLED=true
ASTERISK_ARI_BASE_URL=http://asterisk:8088
ASTERISK_ARI_WS_URL=ws://asterisk:8088/ari/events
ASTERISK_ARI_USER=dongdo
ASTERISK_ARI_PASS=dongdoari
ASTERISK_ARI_APP=dongdo-ivr
ASTERISK_ARI_RECONNECT_SEC=5

