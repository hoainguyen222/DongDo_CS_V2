# =============================================================================
# Monitoring stack ENV — read by monitoring/docker-compose.monitoring.yml
# =============================================================================
# Copy this file to .env.monitoring (in repo root) and override values there.
# Compose auto-loads it for the monitoring profile.

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
# Port on the host (NOT 3000 to avoid collision with Next.js dev server)
GRAFANA_PORT=3050

# Admin user/password. CHANGE THESE BEFORE EXPOSING GRAFANA ANYWHERE.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Public root URL — used in alert emails, dashboard links, etc.
GRAFANA_ROOT_URL=http://localhost:3050

# Comma-separated list of Grafana plugins to auto-install at boot.
# Default: redis-datasource (Postgres datasource is built-in).
GRAFANA_PLUGINS=redis-datasource

# Toggle individual datasources. "true" = provisioned at boot, "false" = hidden.
GRAFANA_PG_DATASOURCE=true
GRAFANA_REDIS_DATASOURCE=true
