  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by(route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "title": "Error Rate (5xx %)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by(route) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by(route) (rate(http_requests_total[5m])) * 100",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries",
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by(le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by(le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 6},
      "id": 4,
      "title": "Goroutines",
      "type": "timeseries",
      "targets": [
        {"expr": "go_goroutines", "legendFormat": "goroutines", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 6},
      "id": 5,
      "title": "Heap In-Use / Allocated",
      "type": "timeseries",
      "targets": [
        {"expr": "go_memstats_heap_inuse_bytes", "legendFormat": "heap inuse", "refId": "A"},
        {"expr": "go_memstats_heap_alloc_bytes", "legendFormat": "heap alloc", "refId": "B"},
        {"expr": "go_memstats_sys_bytes", "legendFormat": "sys", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
